<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<targets>
		<!-- Log target: Writes daily rolling text files in App_Data/Logs -->
		<target name="fileTarget"
				xsi:type="File"
				fileName="${basedir}/App_Data/Logs/${shortdate}.log"
				layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message}${newline}${exception:format=tostring}${newline}--------------------------------------------------${newline}" />
	</targets>

	<rules>
		<!-- Capture all logs from Info level up to Fatal -->
		<logger name="*" minlevel="Info" writeTo="fileTarget" />
	</rules>

</nlog>